# ───────────────────────────── Runtime ─────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Proxies in front of the API: 1 locally, 2 in production (Vercel rewrite + Render)
TRUST_PROXY_HOPS=1

# ─────────────── Infrastructure (matches docker-compose.yml) ───────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ─────────────────────────── Security (REQUIRED) ───────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-hex-chars
ENCRYPTION_KEY=replace-with-64-hex-chars
JWT_EXPIRES_IN_SECONDS=604800
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ───────────────────── Google OAuth (REQUIRED for Google login) ─────────────────────
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ──────────────── Slack OAuth (REQUIRED for rate-limit alerts) ────────────────
# https://api.slack.com/apps -> Create App -> OAuth & Permissions
# Bot scope: incoming-webhook. Slack needs an HTTPS redirect URL: the API serves one on
# https://localhost:LOCAL_HTTPS_PORT with a self-signed cert (no tunnel needed).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://localhost:4443/api/slack/oauth/callback
LOCAL_HTTPS_PORT=4443

# ───────────────────────────── SMTP senders ─────────────────────────────
# Leave empty: Ethereal accounts are generated automatically on first start.
# Or pin your own Ethereal accounts (https://ethereal.email/create): user:pass,user:pass
ETHEREAL_SENDERS=
ETHEREAL_AUTO_CREATE_COUNT=3

# ─────────────────── Throughput, rate limiting & concurrency ───────────────────
WORKER_CONCURRENCY=5
# Minimum gap between any two sends across all workers (provider throttling)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hourly caps (0 disables). Campaign-level caps come from the compose form.
MAX_EMAILS_PER_HOUR=500
MAX_EMAILS_PER_HOUR_PER_SENDER=200
EMAIL_MAX_ATTEMPTS=3
MAX_RECIPIENTS_PER_CAMPAIGN=10000

# ───────────────────────── Bull Board (/admin/queues) ─────────────────────────
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-please

API_RATE_LIMIT_PER_MINUTE=300
